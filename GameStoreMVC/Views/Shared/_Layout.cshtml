@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using GameStoreMVC.Models
@inject IHttpContextAccessor HttpContextAccessor

@{
    int cantidadEnCarrito = 0;
    var sessionCarrito = HttpContextAccessor.HttpContext.Session.GetString("Carrito");

    if (!string.IsNullOrEmpty(sessionCarrito))
    {
        var carrito = JsonSerializer.Deserialize<List<CarritoItem>>(sessionCarrito);
        cantidadEnCarrito = carrito.Sum(x => x.Cantidad);
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameStoreMVC</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GameStoreMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="top-header py-2 border-bottom bg-white">
            <div class="container">
                <div class="row align-items-center">

                    <div class="col-md-3">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                            <img src="~/images/gamestore.png"
                                 alt="GameStore"
                                 style="max-height: 60px; width: auto; transform: scale(1.6); transform-origin: left center; margin-left: 10px;">
                        </a>
                    </div>

                    <div class="col-md-6">
                        <form class="d-flex" role="search">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input class="form-control bg-light border-start-0 shadow-none" type="search" placeholder="Buscar juegos, consolas y accesorios..." aria-label="Search">
                            </div>
                        </form>
                    </div>

                    <div class="col-md-3 d-flex justify-content-end align-items-center gap-3">

                        <div class="login-section border-end pe-3">
                            @if (User.Identity!.IsAuthenticated)
                            {
                                <div class="dropdown">
                                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-check-fill fs-3 text-orange me-2"></i>
                                        <span class="fw-bold small d-none d-md-block">@User.Identity.Name</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                        <li><h6 class="dropdown-header">Hola, @User.Identity.Name</h6></li>
                                        <li><a class="dropdown-item" href="#">Mi Perfil</a></li>

                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link fw-bold text-danger" asp-controller="Producto" asp-action="Index">
                                                    <i class="bi bi-gear-fill me-1"></i> ADMIN
                                                </a>
                                            </li>
                                        }

                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Salir">Cerrar Sesión</a></li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a asp-controller="Auth" asp-action="Login" class="text-decoration-none" title="Iniciar Sesión">
                                    <i class="bi bi-person-fill fs-3 text-orange"></i>
                                </a>
                            }
                        </div>

                        <div class="cart-section">
                            <a asp-controller="Carrito" asp-action="Checkout" class="text-decoration-none position-relative">
                                <i class="bi bi-bag fs-4 text-orange"></i>

                                @if (cantidadEnCarrito > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                                        @cantidadEnCarrito
                                    </span>
                                }
                                else
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                                        0
                                    </span>
                                }
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-2">
            <div class="container justify-content-center">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse flex-grow-0" id="mainNav">
                    <ul class="navbar-nav fw-bold gap-4">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Categoria" asp-route-idCategoria="1">Videojuegos PS5</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Categoria" asp-route-idCategoria="2">Videojuegos Switch</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Categoria" asp-route-idCategoria="3">Consolas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Categoria" asp-route-idCategoria="4">Accesorios</a>
                        </li>

                        <li class="nav-item d-none">
                            <a class="nav-link" asp-controller="Producto" asp-action="Index">Admin Productos</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            &copy; 2025 - GameStoreMVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>