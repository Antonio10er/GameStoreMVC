@model GameStoreMVC.Models.HomeViewModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-5 bg-light mb-5 rounded-3">
    <h1 class="display-5 fw-bold text-dark">ENCUENTRA JUEGOS, CONSOLAS Y ACCESORIOS</h1>
    <p class="fs-5 text-muted">Los mejores precios en un solo lugar.</p>
</div>

<div class="container mb-5">

    <div class="d-flex justify-content-between align-items-center mt-5 mb-4 border-bottom pb-2">
        <h2 style="color: #ff4500; font-weight: bold;">PlayStation 5</h2>
        <a asp-controller="Home" asp-action="Categoria" asp-route-idCategoria="1" class="btn btn-outline-danger rounded-pill px-4">VER TODO</a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @if (Model.JuegosPS5.Any())
        {
            @foreach (var item in Model.JuegosPS5)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <div class="text-center bg-white p-3 position-relative">
                            <a asp-controller="Home" asp-action="Detalle" asp-route-idProducto="@item.IdProducto">
                                <img src="@item.ImagenUrl" class="img-fluid" alt="@item.Nombre" style="height: 200px; object-fit: contain; transition: transform 0.2s;">
                            </a>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-truncate">
                                <a asp-controller="Home" asp-action="Detalle" asp-route-idProducto="@item.IdProducto" class="text-decoration-none text-dark fw-bold stretched-link">
                                    @item.Nombre
                                </a>
                            </h5>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fs-5 fw-bold text-orange" style="color: #ff4500;">S/ @item.Precio.ToString("0.00")</span>
                                    <span class="badge bg-secondary text-white">Stock: @item.Stock</span>
                                </div>
                                <a asp-controller="Home" asp-action="Detalle" asp-route-idProducto="@item.IdProducto" class="btn btn-primary w-100 fw-bold">
                                    Ver Detalles
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No hay productos disponibles en esta categoría.</p>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-5 mb-4 border-bottom pb-2">
        <h2 style="color: #ff4500; font-weight: bold;">Nintendo Switch</h2>
        <a asp-controller="Home" asp-action="Categoria" asp-route-idCategoria="2" class="btn btn-outline-danger rounded-pill px-4">VER TODO</a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model.JuegosSwitch)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 product-card">
                    <div class="text-center bg-white p-3 position-relative">
                        <a asp-controller="Home" asp-action="Detalle" asp-route-idProducto="@item.IdProducto">
                            <img src="@item.ImagenUrl" class="img-fluid" alt="@item.Nombre" style="height: 200px; object-fit: contain; transition: transform 0.2s;">
                        </a>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate">
                            <a asp-controller="Home" asp-action="Detalle" asp-route-idProducto="@item.IdProducto" class="text-decoration-none text-dark fw-bold stretched-link">
                                @item.Nombre
                            </a>
                        </h5>
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="fs-5 fw-bold text-orange" style="color: #ff4500;">S/ @item.Precio.ToString("0.00")</span>
                                <span class="badge bg-secondary text-white">Stock: @item.Stock</span>
                            </div>
                            <a asp-controller="Home" asp-action="Detalle" asp-route-idProducto="@item.IdProducto" class="btn btn-primary w-100 fw-bold">Ver Detalles</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-5 mb-4 border-bottom pb-2">
        <h2 style="color: #ff4500; font-weight: bold;">Consolas</h2>
        <a asp-controller="Home" asp-action="Categoria" asp-route-idCategoria="3" class="btn btn-outline-danger rounded-pill px-4">VER TODO</a>
