                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

</div>

<style>
    .product-card:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }

    .product-card img:hover {
        transform: scale(1.05);
    }
</style>