                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-5 mb-4 border-bottom pb-2">
        <h2 style="color: #ff4500; font-weight: bold;">Accesorios</h2>
        <a asp-controller="Home" asp-action="Categoria" asp-route-idCategoria="4" class="btn btn-outline-danger rounded-pill px-4">VER TODO</a>
