@model IEnumerable<GameStoreMVC.Models.ProductoModel>

@{
    ViewData["Title"] = ViewBag.NombreCategoria;
}

<div class="bg-light py-5 mb-5 text-center">
    <div class="container">
        <h1 class="display-4 fw-bold" style="color: #ff4500;">@ViewBag.NombreCategoria</h1>
        <p class="lead text-muted">Explora nuestro catálogo seleccionado.</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card">

                        <div class="text-center bg-white p-3 position-relative">
                            <a asp-controller="Home" asp-action="Detalle" asp-route-idProducto="@item.IdProducto">
                                <img src="@item.ImagenUrl" class="img-fluid" alt="@item.Nombre"
                                     style="height: 200px; object-fit: contain; transition: transform 0.2s;">
                            </a>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-truncate">
                                <a asp-controller="Home" asp-action="Detalle" asp-route-idProducto="@item.IdProducto"
                                   class="text-decoration-none text-dark fw-bold stretched-link">
                                    @item.Nombre
                                </a>
                            </h5>

                            <p class="card-text small text-muted mb-2">@item.Formato - @item.Edicion</p>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fs-5 fw-bold text-orange" style="color: #ff4500;">S/ @item.Precio.ToString("0.00")</span>

                                    @if (item.Stock > 0)
                                    {
                                        <span class="badge bg-secondary text-white">Stock: @item.Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Agotado</span>
                                    }
                                </div>

                                <a asp-controller="Home" asp-action="Detalle" asp-route-idProducto="@item.IdProducto"
                                   class="btn btn-primary w-100 fw-bold">Ver Detalles</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <h3 class="text-muted">No hay productos disponibles en esta categoría por el momento.</h3>
                <a asp-action="Index" class="btn btn-outline-secondary mt-3">Volver al Inicio</a>
            </div>
        }
    </div>
</div>

<style>
    .product-card:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }

    .product-card img:hover {
        transform: scale(1.05);
    }
</style>