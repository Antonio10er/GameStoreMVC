@{
    ViewData["Title"] = "¡Pedido Exitoso!";
}

<div class="container text-center py-5">
    <div class="mb-4">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
    </div>

    <h1 class="fw-bold mb-3">¡Gracias por tu compra!</h1>
    <p class="lead text-muted">Tu pedido ha sido procesado correctamente.</p>

    <div class="mt-5">
        <a asp-controller="Carrito" asp-action="DescargarBoleta" target="_blank" class="btn btn-danger btn-lg px-5 shadow-sm">
            <i class="bi bi-file-earmark-pdf-fill"></i> Descargar Boleta PDF
        </a>

        <br /><br />

        <a asp-controller="Home" asp-action="Index" class="btn btn-link text-decoration-none text-muted">
            <i class="bi bi-arrow-left"></i> Seguir comprando
        </a>
    </div>
</div>