@{
    ViewData["Title"] = "Mi Cuenta";
}

<div class="container my-5">
    <h1 class="text-center text-orange fw-bold mb-5">Mi Cuenta</h1>
    
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card bg-light border-0 shadow-sm p-4" style="background-color: #f9f9f9 !important;">
        <div class="row g-5">

            <div class="col-md-6 border-end-md">
                <h3 class="mb-4 fw-bold text-dark">Acceder</h3>
                <form asp-controller="Auth" asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label text-muted">Correo electrónico <span class="text-danger">*</span></label>
                        <input type="email" name="correo" class="form-control bg-white py-2" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">Contraseña <span class="text-danger">*</span></label>
                        <input type="password" name="password" class="form-control bg-white py-2" required>
                    </div>

                    @if (ViewData["Mensaje"] != null)
                    {
                        <div class="alert alert-danger">@ViewData["Mensaje"]</div>
                    }

                    <button type="submit" class="btn btn-orange text-white fw-bold px-4 py-2 mt-3">Acceso</button>
                </form>
            </div>

            <div class="col-md-6 ps-md-5">
                <h3 class="mb-4 fw-bold text-dark">Registrarse</h3>
                <form asp-controller="Auth" asp-action="Registro" method="post">

                    <div class="mb-3">
                        <label class="form-label text-muted">Nombre Completo <span class="text-danger">*</span></label>
                        <input type="text" name="nombre" class="form-control bg-white py-2" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Correo electrónico <span class="text-danger">*</span></label>
                        <input type="email" name="correo" class="form-control bg-white py-2" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Contraseña <span class="text-danger">*</span></label>
                        <input type="password" name="password" class="form-control bg-white py-2" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Teléfono (Opcional)</label>
                        <input type="text" name="telefono" class="form-control bg-white py-2">
                    </div>

                    <p class="text-muted small my-3">
                        Tus datos personales se utilizarán para gestionar el acceso a tu cuenta.
                    </p>

                    <button type="submit" class="btn btn-orange text-white fw-bold px-4 py-2 w-100">Registrarse</button>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($('.alert-success').length) {
                setTimeout(function() {
                    $('.alert-success').fadeOut('slow', function() {
                        $(this).remove();
                    });
                }, 4000);
            }
        });
    </script>
}